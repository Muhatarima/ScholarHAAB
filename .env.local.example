NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite,gemini-2.0-flash
LLM_PROVIDER_ORDER=groq,gemini
LLM_RETRY_ATTEMPTS=2
LLM_TIMEOUT_MS=30000

# Best retrieval quality: expose all-MiniLM-L6-v2 from a tiny Python service and set this URL.
MINILM_EMBEDDING_API_URL=
MINILM_EMBEDDING_API_KEY=

# Local development only. Do not rely on Python inside Vercel serverless.
LOCAL_EMBEDDING_ENABLED=false
LOCAL_EMBEDDING_PYTHON_BIN=python
LOCAL_EMBEDDING_SCRIPT=scripts/embed-query.py
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Deployable fallback if MiniLM service is not configured. It keeps the app working,
# but existing MiniLM-indexed documents retrieve best with MiniLM query embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_MATCH_THRESHOLD=0.65

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_APP_NAME=ScholarHAAB
HIDE_PAYMENT=true
NEXT_PUBLIC_HIDE_PAYMENT=true
